# Environment variables for Airflow deployment

# Nexus Docker Registry
NEXUS_REGISTRY=nexus.yourcompany.com:8443
NEXUS_USERNAME=your-nexus-username
NEXUS_PASSWORD=your-nexus-password

# Airflow Configuration
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=your-fernet-key-here

# MySQL Configuration
MYSQL_ROOT_PASSWORD=your-root-password
MYSQL_PASSWORD=your-airflow-password

# Image Configuration
IMAGE_NAME=airflow-custom
IMAGE_TAG=latest
