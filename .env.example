# Airflow Deployment Environment Variables
# Copy this file to .env and update with your values

# Docker Image Configuration
CUSTOM_IMAGE_NAME=airflow-custom
CUSTOM_IMAGE_TAG=latest-stable

# Airflow Configuration
AIRFLOW_UID=50000
AIRFLOW_GID=50000

# Nexus Registry (for pushing stable images)
NEXUS_REGISTRY=your-nexus-registry.com
NEXUS_REPO=docker-releases
NEXUS_USERNAME=
NEXUS_PASSWORD=

# Server Configuration
SERVER_131_HOST=172.10.17.131
SERVER_130_HOST=172.10.17.130
SSH_PORT=3535
SSH_USER=dataeng99
DEPLOY_USER=developer

# Paths
CODE_BASE_PATH=/data/code/99acres_analytics/data_lake_tools/data-platform-applications/airflow
DOCKER_COMPOSE_BIN=/data/binaries/docker-compose

# Health Check Configuration
MAX_HEALTH_CHECK_RETRIES=5
HEALTH_CHECK_SLEEP_SECONDS=15
CONTAINER_INIT_WAIT_SECONDS=30

# Git Configuration
CI_COMMIT_SHORT_SHA=
CI_COMMIT_SHA=
